{
  "name": "lrc-studio-server",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.34.8",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@crimson-carnival/ds-js": "1.0.2",
    "@fastify/compress": "8.3.1",
    "@fastify/cookie": "11.1.3",
    "@fastify/cors": "10.1.0",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.6",
    "@fastify/rate-limit": "10.3.0",
    "@pulsecron/pulse": "1.6.8",
    "@simplewebauthn/server": "14.0.3",
    "@socket.io/mongo-adapter": "^0.4.0",
    "argon2": "0.45.1",
    "cloudinary": "2.11.0",
    "cookie": "2.0.1",
    "dotenv": "18.0.9",
    "fastify": "5.12.7",
    "fastify-plugin": "5.1.0",
    "geoip-lite": "^2.0.3",
    "graphql": "16.14.0",
    "i18next": "26.5.10",
    "jsonwebtoken": "9.0.3",
    "mercurius": "16.12.1",
    "mongoose": "8.24.0",
    "nanoid": "6.0.2",
    "pino-pretty": "13.2.0",
    "sanitize-html": "2.18.1",
    "socket.io": "4.8.4",
    "ua-parser-js": "2.0.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "bcrypt",
      "esbuild",
      "mongodb-memory-server"
    ],
    "overrides": {
      "@socket.io/mongo-adapter>mongodb": "~6.20.0"
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/geoip-lite": "^1.4.4",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.19.2",
    "@types/sanitize-html": "2.16.2",
    "@types/ua-parser-js": "0.7.39",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "mongodb-memory-server": "11.3.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
