# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Server Configuration
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Database
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/dbName?retryWrites=true&w=majority

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# JWT Authentication
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
JWT_SECRET=change-this-to-a-random-secret-at-least-32-chars

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Cookie Signing (Required in production — must differ from JWT_SECRET)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
COOKIE_SECRET=change-this-to-a-different-random-secret-at-least-32-chars

JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d
JWT_ISSUER=https://your-app-domain.com
JWT_AUDIENCE=https://your-app-domain.com

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# CORS & App URLs
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Comma-separated list of allowed origins for CORS
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Primary app URLs (comma-separated for multiple environments)
# The last URL is used as the primary
APP_URL=http://localhost:5173,https://lrc-studio.vercel.app

# URL used for password reset email links (should match your frontend domain)
PASSWORD_RESET_URL=http://localhost:5173

# App name for emails and UI
APP_NAME=LRC Studio

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Email Configuration
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_SMTP_USER=your-email@gmail.com
EMAIL_SMTP_PASS=your-app-password
EMAIL_FROM="LRC Studio <noreply@lrc-studio.com>"

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Superadmin Bootstrap
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# The ONLY way to grant the superadmin role — it is never assignable via the
# UI. Comma-separated list; each entry must match a user's email exactly
# (case-insensitive, no wildcards). Applied at startup and on registration /
# Google sign-up. Grant-only: removing an entry never demotes anyone, so
# revocation stays a deliberate manual step (scripts/grant-role.ts).
# Leave blank to grant to nobody.
SUPERADMIN_EMAIL=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Security - reCAPTCHA v3
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Rate Limiting
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# RATE_LIMIT_MAX: max requests per window per client (default: 200)
# RATE_LIMIT_WINDOW_MS: window duration in milliseconds (default: 60000 = 1 min)
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW_MS=60000

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Cloudinary (Image & Media Storage)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Optional: Get from https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# YouTube Data API (Optional)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# For auto-fetching video titles and metadata
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Google OAuth Integration (Optional)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Get from https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your-youtube-api-key

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Google OAuth Integration (Optional)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Get from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-backend-domain/google/auth/callback
GOOGLE_LOGIN_REDIRECT_URI=https://your-backend-domain/google/login/callback

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Song Metadata Lookup (Optional — for "fetch song info" in project setup)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Client-credentials app keys for a track-metadata provider (e.g. Spotify
# Developer Dashboard). No user login involved — app-level lookup only.
TRACK_METADATA_CLIENT_ID=your-client-id
TRACK_METADATA_CLIENT_SECRET=your-client-secret
# Optional fallback provider if the above isn't configured
LASTFM_API_KEY=your-lastfm-api-key

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Lyrics Search & Import (all optional)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Lyrics are fetched through a provider chain. NOTHING here is required —
# with none of these set, search falls back to LRCLIB and lyric lookup runs
# LRCLIB -> lyrics.ovh -> Musixmatch, all of which are keyless.
#
#   LRCLIB     — keyless, and the only provider that returns already-synced
#                (timestamped) lyrics. Identifies itself via APP_URL above.
#   LyricFind  — licensed commercial API; skipped entirely without a key.
#   lyrics.ovh — keyless, plain text only.
#   Musixmatch — keyless scraper, last resort.
#
# Optional: richer search results (cover art, better fuzzy matching).
# Get from https://genius.com/api-clients
GENIUS_CLIENT_ACCESS_TOKEN=

# Optional: requires a commercial agreement with LyricFind — there is no
# free tier or self-signup. Leave blank to skip this provider.
LYRICFIND_API_KEY=
# Display territory for LyricFind licensing checks (defaults to US)
LYRICFIND_TERRITORY=US

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Auto Stamp — Speech Recognition (Optional)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Groq API key for Whisper transcription — required for the Auto Stamp
# feature. Without it /asr/stamp returns asr_invalid_key and the Auto Stamp
# button is the only thing that stops working. Get from https://console.groq.com
GROQ_API_KEY=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Auto Stamp — YouTube Audio Extraction (Optional)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Auto Stamp works on YouTube sources as well as uploaded files; the audio is
# extracted server-side with yt-dlp. Without yt-dlp available, only local
# files and Cloudinary uploads can be stamped.
# Optional: absolute path to the yt-dlp binary (defaults to `yt-dlp` on PATH)
YTDLP_PATH=
# Optional: base URL of the bgutil PO token provider sidecar
# (https://github.com/Brainicism/bgutil-ytdlp-pot-provider). Required in
# production — datacenter IPs are bot-checked by YouTube without a PO token.
# When set, the plugin zip must exist at ./yt-dlp-plugins (render-build.sh
# downloads it). e.g. http://localhost:4416
YTDLP_POT_PROVIDER_URL=
